to directstop
  stop
end
to outputtaila
  output outputtailb
end
to outputtailb
  output outputtailc
end
to outputtailc
  stop
end
to commandtaila
  commandtailb
end
to commandtailb
  stop
end

to fallchaina
  output fallchainb
end
to fallchainb
  fallchainc
end
to fallchainc
  stop
end
to falloffif
  if "true [print 1]
end
to falloffrepeat
  repeat 2 [print 1]
end
to falloffforeach
  foreach [1 2] [stop]
end
to show1 :x
  print :x
end
to defaultuser [:x directstop]
  print :x
end
.macro macstop
  stop
end
.macro macword
  output "abc
end
to maybeempty
  .maybeoutput directstop
  print 1
end
to opinarg
  print output 3
end
to stopinarg
  print stop
end
to viaifelse
  ifelse "true [output directstop] [output 1]
end
to viarun
  output run [directstop]
end
to viacatch
  output catch "x [directstop]
end
to wrapper
  print directstop
end
to seqcase
  print directstop
  print 2
end

print [CASE 01 direct stop as print operand]
catch "error [print directstop]
show error
print [CASE 02 tail output chain ends in stop]
catch "error [print outputtaila]
show error
print [CASE 03 command tail chain ends in stop]
catch "error [print commandtaila]
show error
print [CASE 04 direct stop as arithmetic operand]
catch "error [print 1 + directstop]
show error
print [CASE 05 output then fall off chain]
catch "error [print fallchaina]
show error
print [CASE 06 if body falls off as print operand]
catch "error [print falloffif]
show error
print [CASE 07 repeat body falls off as print operand]
catch "error [print falloffrepeat]
show error
print [CASE 08 foreach stop procedure as print operand]
catch "error [print falloffforeach]
show error
print [CASE 08b foreach stop as top level print operand]
catch "error [print foreach [1 2] [stop]]
show error
print [CASE 09 primitive command as operand]
catch "error [print ignore 3]
show error
print [CASE 10 user procedure as consumer]
catch "error [show1 directstop]
show error
print [CASE 11 make value from direct stop]
catch "error [make "v directstop]
show error
print [CASE 12 direct stop as if test]
catch "error [if directstop [print 1]]
show error
print [CASE 13 nested first operand]
catch "error [print first directstop]
show error
print [CASE 14 parenthesized variadic sum]
catch "error [print (sum 1 2 directstop)]
show error
print [CASE 15 default value expression]
catch "error [(defaultuser)]
show error
print [CASE 16 apply named stop procedure]
catch "error [print apply "directstop []]
show error
print [CASE 17 apply anonymous stop template]
catch "error [print apply [[x] [stop]] [1]]
show error
print [CASE 18 map direct stop template]
catch "error [print map [directstop] [1 2]]
show error
print [CASE 19 run direct stop list]
catch "error [print run [directstop]]
show error
print [CASE 20 runresult direct stop list]
catch "error [print runresult [directstop]]
show error
print [CASE 21 catch foo around direct stop]
catch "error [print catch "foo [directstop]]
show error
print [CASE 22 macro calls stop]
catch "error [print macstop]
show error
print [CASE 23 macro outputs a word]
catch "error [print macword]
show error
print [CASE 24 maybeoutput without value]
catch "error [print maybeempty]
show error
print [CASE 25 output in print operand position]
catch "error [opinarg]
show error
print [CASE 26 stop in print operand position]
catch "error [print stopinarg]
show error
print [CASE 27 tail call through ifelse]
catch "error [print viaifelse]
show error
print [CASE 28 tail call through run]
catch "error [print viarun]
show error
print [CASE 29 tail call through catch]
catch "error [print viacatch]
show error
print [CASE 30 direct stop with procedure print consumer]
catch "error [wrapper]
show error
print [CASE 31 direct stop in non-tail sequence]
catch "error [seqcase]
show error
