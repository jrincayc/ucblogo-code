{
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/format-whitespace.js post",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .github/hooks/format-whitespace.js stop",
        "timeout": 5
      }
    ]
  }
}
